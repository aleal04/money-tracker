{
	"extends": "@vue/tsconfig/tsconfig.dom.json",
	"compilerOptions": {
		"target": "esnext",
		"module": "esnext",
		"moduleResolution": "bundler",
		"lib": ["esnext", "dom", "dom.iterable"],
		"strict": true,
		"sourceMap": true,
		"skipLibCheck": true,
		"isolatedModules": true,
		"resolveJsonModule": true,
		"paths": {
			"@/*": ["./resources/js/*"],
			"@scss/*": ["./resources/scss/*"]
		},
		"types": ["vite/client"]
	},
	"include": [
		"resources/js/**/*.ts",
		"resources/js/**/*.d.ts",
		"resources/js/**/*.vue",
		"tests/js/**/*.ts",
		"vitest.config.ts"
	],
	"exclude": ["node_modules", "public", "vendor"]
}
